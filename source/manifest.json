{
	"manifest_version": 3,
	"name": "Superlinks",
	"version": "1.1",
	"description": "Replaces the hyperlinks with blue underlined text.",
	"content_scripts": 
	[
		{
			"matches": ["*://*/*"],
			"js": ["content_script.js"],
			"run_at": "document_end"
		}
	],
    "icons": {
        "128": "icon.png"
    },
    "action": {
        "default_icon": "icon.png"
    }
}
